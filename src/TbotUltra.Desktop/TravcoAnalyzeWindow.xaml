<Window x:Class="TbotUltra.Desktop.TravcoAnalyzeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TbotUltra.Desktop.Views"
        Title="Analyze Travco"
        Width="560"
        Height="600"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="Analyze Travco"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Pick a village and inactivity window, analyze the Travco pages, then save every result page as one list."
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- Settings card -->
            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="Search settings"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,12" />
                    <TextBlock Text="Village"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Villages}"
                              SelectedItem="{Binding SelectedVillage}"
                              DisplayMemberPath="NameWithCoords" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Days inactive"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Order by"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                        <TextBox Grid.Row="1" Grid.Column="0"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding DaysInactiveText, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox Grid.Row="1" Grid.Column="2"
                                  ItemsSource="{Binding OrderByOptions}"
                                  SelectedValue="{Binding SelectedOrderBy}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="Label" />
                    </Grid>

                    <TextBlock Text="List name"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,12,0,4" />
                    <TextBox VerticalContentAlignment="Center"
                             Text="{Binding ListName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>

            <!-- Analyze action -->
            <Button Grid.Row="2"
                    x:Name="AnalyzeButton"
                    Content="Analyze Travco"
                    Height="34"
                    MinWidth="160"
                    HorizontalAlignment="Left"
                    Margin="0,14,0,0"
                    FontWeight="SemiBold"
                    Background="{DynamicResource SuccessBgBrush}"
                    BorderBrush="{DynamicResource SuccessBorderBrush}"
                    Foreground="{DynamicResource SuccessTextBrush}"
                    Click="AnalyzeButton_Click" />

            <!-- Analysis result + save action -->
            <StackPanel Grid.Row="3"
                        x:Name="ResultsPanel"
                        Visibility="Collapsed"
                        Margin="0,14,0,0">
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="Analysis result"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{DynamicResource InfoBgBrush}"
                                    BorderBrush="{DynamicResource FocusBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,10">
                                <StackPanel>
                                    <TextBlock x:Name="PagesValue" Text="-"
                                               FontSize="22" FontWeight="SemiBold"
                                               Foreground="{DynamicResource InfoTextStrongBrush}" />
                                    <TextBlock Text="Pages"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Background="{DynamicResource InfoBgBrush}"
                                    BorderBrush="{DynamicResource FocusBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,10">
                                <StackPanel>
                                    <TextBlock x:Name="VillagesValue" Text="-"
                                               FontSize="22" FontWeight="SemiBold"
                                               Foreground="{DynamicResource InfoTextStrongBrush}" />
                                    <TextBlock Text="Villages"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Bottom bar: Save all (left, shown after analysis) and Close (right, always) share one row. -->
            <Grid Grid.Row="5" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="SaveAllButton"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="Save all pages as list"
                        Height="34"
                        MinWidth="180"
                        Visibility="Collapsed"
                        IsEnabled="False"
                        FontWeight="SemiBold"
                        Background="{DynamicResource SuccessBgBrush}"
                        BorderBrush="{DynamicResource SuccessBorderBrush}"
                        Foreground="{DynamicResource SuccessTextBrush}"
                        Click="SaveAllButton_Click" />
                <Button Grid.Column="1"
                        Width="100"
                        Height="34"
                        VerticalAlignment="Center"
                        Content="Close"
                        Click="CloseButton_Click" />
            </Grid>
        </Grid>

        <views:BusyOverlayControl x:Name="BusyOverlay"
                                  ShowCancel="False"
                                  Cancelled="BusyOverlay_Cancelled"
                                  Title="Analyze Travco"
                                  Text="Working..." />
    </Grid>
</Window>
