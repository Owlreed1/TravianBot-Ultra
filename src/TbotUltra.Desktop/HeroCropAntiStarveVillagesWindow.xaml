<Window x:Class="TbotUltra.Desktop.HeroCropAntiStarveVillagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anti-starve villages" Width="460" Height="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Select villages to protect" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="New villages are enabled by default. The account-wide checkbox remains the master switch."
                       Margin="0,5,0,12" TextWrapping="Wrap" Opacity="0.75" />
            <StackPanel Orientation="Horizontal">
                <Button Content="Select all" Padding="12,5" Margin="0,0,8,0" Click="SelectAll_Click" />
                <Button Content="Select none" Padding="12,5" Click="SelectNone_Click" />
            </StackPanel>
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,14,0,14" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="0,0,0,1" Padding="6,9">
                            <CheckBox Content="{Binding VillageName}"
                                      IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" MinWidth="85" Padding="12,6" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="OK" MinWidth="85" Padding="12,6" IsDefault="True" Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
