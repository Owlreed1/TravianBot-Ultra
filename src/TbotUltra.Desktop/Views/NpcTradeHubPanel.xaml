<UserControl x:Class="TbotUltra.Desktop.Views.NpcTradeHubPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TbotUltra.Desktop.Views">
  <TabControl x:Name="NpcTradeTabControl" Background="{DynamicResource AppBackgroundBrush}">
    <TabItem x:Name="NpcTabItem" Header="NPC">
      <views:NpcTradePanel x:Name="NpcContent" Section="NPC" />
    </TabItem>
    <TabItem x:Name="SilverTradingTabItem" Header="Silver trading">
      <Border Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="16">
        <StackPanel VerticalAlignment="Top">
          <TextBlock Text="Silver trading"
                     FontSize="22"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="Silver trading automation is not available yet."
                     Margin="0,8,0,0"
                     Foreground="{DynamicResource TextSubtleBrush}" />
        </StackPanel>
      </Border>
    </TabItem>
  </TabControl>
</UserControl>
