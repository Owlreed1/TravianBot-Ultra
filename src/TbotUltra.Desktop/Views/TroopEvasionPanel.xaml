<UserControl x:Class="TbotUltra.Desktop.Views.TroopEvasionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="4">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal">
      <TextBlock Text="Troop evasion" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
      <ContentControl x:Name="TroopEvasionInfoIcon"
                      Style="{DynamicResource InfoTooltipIconStyle}"
                      Margin="8,0,0,0"
                      ToolTip="Sends selected troops shortly before a confirmed incoming red attack." />
    </StackPanel>

    <Border Grid.Row="1" Margin="0,12,0,10" Padding="12" CornerRadius="7"
            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Lead time" VerticalAlignment="Center" />
          <ContentControl x:Name="LeadTimeInfoIcon"
                          Style="{DynamicResource InfoTooltipIconStyle}"
                          Margin="5,0,6,0"
                          ToolTip="How many minutes before the incoming attack the evasion attempt starts." />
          <ComboBox x:Name="LeadTimeComboBox" Width="80" SelectionChanged="GlobalSetting_Changed" />
          <TextBlock Text="min" VerticalAlignment="Center" Margin="5,0,20,0" />
          <TextBlock Text="Protection window" VerticalAlignment="Center" />
          <ContentControl x:Name="ProtectionWindowInfoIcon"
                          Style="{DynamicResource InfoTooltipIconStyle}"
                          Margin="5,0,6,0"
                          ToolTip="How long after the first triggering arrival another evasion send is suppressed." />
          <ComboBox x:Name="ProtectionWindowComboBox" Width="80" SelectionChanged="GlobalSetting_Changed" />
          <TextBlock Text="min" VerticalAlignment="Center" Margin="5,0,20,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
          <TextBlock Text="Target coordinates" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Text="X" VerticalAlignment="Center" Margin="12,0,0,0" />
          <TextBox x:Name="TargetXTextBox" Width="70" Margin="6,0,12,0" TextChanged="GlobalDispatchSetting_Changed" />
          <TextBlock Text="Y" VerticalAlignment="Center" />
          <TextBox x:Name="TargetYTextBox" Width="70" Margin="6,0,20,0" TextChanged="GlobalDispatchSetting_Changed" />
          <TextBlock Text="Movement" FontWeight="SemiBold" VerticalAlignment="Center" />
          <ComboBox x:Name="MovementTypeComboBox" Width="140" Margin="8,0,0,0" SelectionChanged="GlobalDispatchSetting_Changed" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
          <TextBlock Text="Evade for:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
          <CheckBox x:Name="EvadeRaidsCheckBox" Content="Raids" IsChecked="True"
                    Checked="GlobalEvadeForSetting_Changed" Unchecked="GlobalEvadeForSetting_Changed"
                    Margin="0,0,18,0" />
          <CheckBox x:Name="EvadeAttacksCheckBox" Content="Attacks" IsChecked="True"
                    Checked="GlobalEvadeForSetting_Changed" Unchecked="GlobalEvadeForSetting_Changed" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="VillageItemsControl">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Expander Margin="0,0,0,8" Padding="10" Background="{DynamicResource SurfaceBrush}"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
              <Expander.Header>
                <Grid Width="840" Margin="14,0,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" /><ColumnDefinition Width="165" /><ColumnDefinition Width="160" />
                    <ColumnDefinition Width="112" /><ColumnDefinition Width="92" /><ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <ToggleButton Width="36" Height="20" Style="{StaticResource AutomationToggleStyle}"
                                IsChecked="{Binding Enabled}" Tag="{Binding}" Click="VillageSetting_Changed"
                                VerticalAlignment="Center" ToolTip="Enable troop evasion for this village" />
                  <TextBlock Grid.Column="1" Text="{Binding VillageName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding TroopSummary}" VerticalAlignment="Center" />
                  <Button Grid.Column="3" Content="Sync settings" Tag="{Binding}" Click="SyncSettings_Click" Margin="4,0" />
                  <Button Grid.Column="4" Content="Validate" Tag="{Binding}" Click="Validate_Click" Margin="4,0" />
                  <TextBlock Grid.Column="5" Text="{Binding RuntimeStatus}" VerticalAlignment="Center"
                             Margin="8,0,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                </Grid>
              </Expander.Header>

              <StackPanel Margin="42,12,0,4">
                <TextBlock Text="Troops to evade" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Units}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Expander}}"
                                Checked="VillageSetting_Changed" Unchecked="VillageSetting_Changed" Margin="0,0,16,7" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <CheckBox Content="Hero" IsChecked="{Binding IncludeHero}" Tag="{Binding}"
                          Checked="VillageSetting_Changed" Unchecked="VillageSetting_Changed" />
                <TextBlock Text="{Binding HeroRiskWarning}" Foreground="{DynamicResource WarningBrush}" Margin="0,6,0,0" />
              </StackPanel>
            </Expander>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
