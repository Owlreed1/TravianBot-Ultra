<Window x:Class="TbotUltra.Desktop.DemolishOverviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Demolish overview" Width="560" Height="390" MinWidth="440" MinHeight="260"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Demolish overview" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="Current demolition state for every village." Margin="0,4,0,0"
                       Foreground="{DynamicResource TextSubtleBrush}" />
        </StackPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Village" Binding="{Binding VillageName}" Width="1.1*" />
                <DataGridTextColumn Header="Demolish" Binding="{Binding DemolishStatus}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>
        <Button Grid.Row="2" Content="Close" Width="90" Height="30" HorizontalAlignment="Right"
                Margin="0,12,0,0" IsCancel="True" Click="CloseButton_Click" />
    </Grid>
</Window>
