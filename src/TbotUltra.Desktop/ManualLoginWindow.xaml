<Window x:Class="TbotUltra.Desktop.ManualLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manual login"
        Width="520"
        Height="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Manual login"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="Complete the sign-in in the Travian browser." />
            <Border Margin="0,12,0,0"
                    Padding="12"
                    CornerRadius="6"
                    Background="{DynamicResource WarningBgBrush}"
                    BorderBrush="{DynamicResource WarningBorderBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               Foreground="{DynamicResource WarningTextBrush}"
                               Text="STOP when the lobby shows your game worlds / servers." />
                    <TextBlock Margin="0,5,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="Do not click Play now. Return to Tbot Ultra and click Login done." />
                </StackPanel>
            </Border>
        </StackPanel>
        <TextBlock x:Name="ValidationTextBlock"
                   Grid.Row="2"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource DangerTextBrush}"
                   Visibility="Collapsed" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="118"
                    Margin="0,0,10,0"
                    Content="Login done"
                    Background="{DynamicResource SuccessBgBrush}"
                    BorderBrush="{DynamicResource SuccessBorderBrush}"
                    Foreground="{DynamicResource SuccessTextBrush}"
                    Click="LoginDoneButton_Click" />
            <Button Width="96"
                    Content="Cancel"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
